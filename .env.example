# --- PostgreSQL ---------------------------------------------------------
# Used by docker-compose.yml for the local reference database.
POSTGRES_PASSWORD=foodfinder-dev

# --- Spring datasource (JDBC form) ---------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/foodfinder
SPRING_DATASOURCE_USERNAME=foodfinder
SPRING_DATASOURCE_PASSWORD=foodfinder-dev

# --- Admin (one environment-configured admin user for the prototype) -----
FOODFINDER_ADMIN_USERNAME=admin
FOODFINDER_ADMIN_PASSWORD=change-me

# --- Files ----------------------------------------------------------------
FOODFINDER_STORAGE_DIR=/data/foodfinder

# --- CORS (comma-separated exact origins, no wildcards) --------------------
FOODFINDER_ALLOWED_ORIGINS=https://food.treloc.com

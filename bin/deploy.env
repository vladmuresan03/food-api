# Mapping of 1Password item UUIDs used by bin/deploy.sh.
#
# Copy this file to bin/deploy.env and fill in the IDs for your vault.
#
# To find an item's UUID:
#   op item list --vault treloc --format json | python3 -c '
#   import json, sys
#   for it in json.load(sys.stdin):
#       for f in it.get("fields", []):
#           if f.get("purpose") == "USERNAME":
#               print(it["id"], it.get("title"), f.get("value")); break'
#
# The defaults below match the layout verified during the prototype:
#   - Portainer:  Login item with username "treloc"
#   - NPM:        Login item with username "murionutz@gmail.com"
OP_ITEM_PORTAINER="wbezt6bzi53zkmkyorve76ghqe"
OP_ITEM_NPM="flnanspwyadpjdelq4gsjcv4le"
